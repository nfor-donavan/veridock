PORT=5000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/veridock
JWT_SECRET=change-me-long-random-string
DESK_ORIGIN=http://localhost:5173
TRACKER_ORIGIN=http://localhost:5174
TRACKER_BASE_URL=tracker.veridock.cm
# Proof storage (leave blank to store on local disk ./uploads)
CLOUDINARY_URL=
# SMS (leave SMS_API_URL blank for mock mode that only logs messages)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=VERIDOCK
# Manager alert emails (leave SMTP_HOST blank for mock mode that only logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Veridock <alerts@veridock.cm>
# First platform owner (used by npm run seed)
SUPER_ADMIN_EMAIL=owner@veridock.cm
SUPER_ADMIN_PASSWORD=ChangeMe#2026
